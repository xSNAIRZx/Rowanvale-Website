# Rowanvale 18.6.1 optional provider setup (copy to .env; never put credentials in browser files)
# Basic automatic page covers work without these keys.
PORT=8080
# Keep localhost:8080 and the same browser profile to preserve existing data.
# TMDB_READ_TOKEN=your_TMDB_API_Read_Access_Token
# IGDB_CLIENT_ID=your_Twitch_application_client_ID
# IGDB_CLIENT_SECRET=your_Twitch_application_secret
# RAWG_API_KEY=your_optional_RAWG_key_for_the_legacy_game_directory
# ROWANVALE_CONTACT=your_contact_email_for_provider_identification
# Optional Steam store lookup uses a public but undocumented store endpoint; opt in explicitly.
# STEAM_CATALOG_ENABLED=1
# Enable these only after confirming your permitted personal caching / license terms.
# ROWANVALE_TMDB_CACHE=1
# ROWANVALE_IGDB_CACHE=1
# Open Library selected private-cover caching is available without a credential.
# No AniList integration: its current terms restrict competing tracker services.
# ROWANVALE_DATA_DIR=an_optional_private_data_directory
# Existing ancillary providers:
# MEALDB_API_KEY=your_supporter_key
# HEARTHBYTE_CONTACT=your_contact_email
