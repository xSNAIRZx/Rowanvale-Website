# Copy to .env.hosted; never commit the filled file.
PUBLIC_URL=https://your-rowanvale-domain.example
PORT=8080
ROWANVALE_DATA_DIR=/data/rowanvale
ROWANVALE_WEB_USER=owner
# REQUIRED: choose a unique password of at least 20 characters.
ROWANVALE_WEB_PASSWORD=
# Optional provider secrets (leave absent if not configured):
# TMDB_READ_TOKEN=
# IGDB_CLIENT_ID=
# IGDB_CLIENT_SECRET=
# RAWG_API_KEY=
# MEALDB_API_KEY=
# ROWANVALE_CONTACT=
# Enable only where provider terms permit private caching:
# ROWANVALE_TMDB_CACHE=1
# ROWANVALE_IGDB_CACHE=1
